# Database configuration
DATABASE_URL=postgresql://gyaanchat:gyaanchat_password@localhost:5432/gyaanchat

# JWT authentication security settings
JWT_SECRET=your-super-secret-jwt-key-change-in-prod
JWT_EXPIRE_MINUTES=1440

# LLM & Embedding provider configuration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Vector database storage paths
CHROMA_PERSIST_DIR=./chroma
RAG_DISTANCE_THRESHOLD=1.2

# Email Settings for OTP Verification (e.g., Gmail SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
